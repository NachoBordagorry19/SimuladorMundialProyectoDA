@rendermode InteractiveServer
@using Dominio.Enums
@using UI.Estado
@inject UsuarioSesion Sesion

<div class="header-bar">
    <div class="hamburguesa @(isOpen ? "active" : "")" @onclick="ToggleMenu">
        <span></span>
        <span></span>
        <span></span>
    </div>

    <span class="logo">WorldCupPlanner</span>
</div>

@if (isOpen)
{
    <div class="menu-overlay" @onclick="ToggleMenu"></div>
}

<div class="sidebar-menu @(isOpen ? "active" : "")">
    <nav class="nav-links">
        <NavLink href="/home" @onclick="CerrarMenu">Inicio</NavLink>
        <NavLink href="/usuarios" @onclick="CerrarMenu">Usuarios</NavLink>
        <NavLink href="/equipos" @onclick="CerrarMenu">Equipos</NavLink>
        <NavLink href="/estadios" @onclick="CerrarMenu">Estadios</NavLink>
        <NavLink href="/fixture" @onclick="CerrarMenu">Fixture</NavLink>
        <NavLink href="/partidos" @onclick="CerrarMenu">Partidos</NavLink>
        <NavLink href="/importar" @onclick="CerrarMenu">Importación</NavLink>

        @if (Sesion.UsuarioActual != null && Sesion.UsuarioActual.Roles.Contains(Rol.Periodista))
        {
            <NavLink href="/notificaciones" @onclick="CerrarMenu">Notificaciones</NavLink>
        }

        <NavLink href="/exportar" @onclick="CerrarMenu">Exportación</NavLink>

    </nav>
</div>

@code {
    private bool isOpen = false;

    private void ToggleMenu()
    {
        isOpen = !isOpen;
    }

    private void CerrarMenu()
    {
        isOpen = false;
    }
}