@rendermode InteractiveServer

<div class="header-bar">
    <div class="hamburguesa @(isOpen ? "active" : "")" @onclick="ToggleMenu">
        <span></span>
        <span></span>
        <span></span>
    </div>
    <span class="logo">WorldCupPlanner</span>
</div>
@if (isOpen)
{
    <div class="menu-overlay" @onclick="ToggleMenu"></div>
}

<div class="sidebar-menu @(isOpen ? "active" : "")">
    
    <nav class="nav-links">
        <NavLink href="/home">Inicio</NavLink>
        <NavLink href="/equipos">Equipos</NavLink>
        <NavLink href="/partidos">Partidos</NavLink>
        <NavLink href="/fixture">Fixture</NavLink>
        <NavLink href="/importar">Importar</NavLink>
    </nav>
</div>

@code {
    private bool isOpen = false;

    private void ToggleMenu()
    {
        isOpen = !isOpen;
    }
}