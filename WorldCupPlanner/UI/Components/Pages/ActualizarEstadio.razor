@page "/ActualizarEstadio"
@using Servicios.Interfaces
@using Servicios.Modelo
@inject IServicioEstadio ServicioEstadio;
@inject NavigationManager Navigation;

<div class="wcp-page">
    <div class="wcp-card">
        <h1 class="wcp-title">Actualizar Estadio</h1>
        <p class="wcp-subtitle">Actualizar datos del estadio.</p>
        
        <div class="row g-3">
            <div class="col-md-6">
                <label class="wcp-form-label">Nombre</label>
                <InputText @bind-Value="estadio.Nombre" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="wcp-form-label">Ciudad</label>
                <InputText @bind-Value="estadio.Ciudad" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="wcp-form-label">Descripción</label>
                <InputText @bind-Value="estadio.Descripcion" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="wcp-form-label">Capacidad</label>
                <InputNumber @bind-Value="estadio.CapacidadLocativa" class="form-control" />
            </div>
        </div>

        <div class="wcp-actions mt-3">
            <button @onclick="Guardar" class="wcp-btn-primary">Guardar</button>
            <NavLink href="/estadios" class="wcp-btn-secondary">Volver</NavLink>
        </div>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="alert alert-@(esError ? "danger" : "success") mt-3">
                @mensaje
            </div>
        }
    </div>
</div>

@code {
    private EstadioDTO estadio = new EstadioDTO();
    private string mensaje = "";
    private bool esError = false;

    protected override void OnInitialized()
    {
        CargarEstadio();
    }

    private void CargarEstadio()
    {
        try
        {
            var queryParams = new Uri(Navigation.Uri).Query;
            var nombreParam = System.Web.HttpUtility.ParseQueryString(queryParams).Get("nombre");
            
            if (!string.IsNullOrEmpty(nombreParam))
            {
                estadio = ServicioEstadio.ObtenerEstadioPorNombre(nombreParam);
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar estadio: {ex.Message}";
            esError = true;
        }
    }

    private void Guardar()
    {
        try
        {
            mensaje = "";
            esError = false;

            ServicioEstadio.ActualizarEstadio(estadio);
            mensaje = "Estadio actualizado correctamente";
            esError = false;
            estadio = new EstadioDTO();
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
    }
}