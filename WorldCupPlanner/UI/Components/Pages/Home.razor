@page "/"
@page "/home"

<div class="home-wrapper">
    <div class="hero-section">
        <div class="hero-header">
            <div class="hero-line"></div>
            <h1>WorldCupPlanner</h1>
            <div class="hero-line"></div>
        </div>
        <div class="hero-accent"></div>
        <p>La plataforma definitiva para la gestión y simulación de torneos internacionales.</p>
        
        <div class="hero-btns">
            <button class="btn-main">Gestionar Usuarios</button>
            <button class="btn-outline">Ver Equipos</button>
        </div>
    </div>

    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon">📅</div>
            <h3>Fixture</h3>
            <p>Organiza los grupos y las fases eliminatorias del mundial.</p>
            <a href="fixture">Explorar →</a>
        </div>

        <div class="feature-card">
            <div class="feature-icon">⚽</div>
            <h3>Partidos</h3>
            <p>Consulta el calendario completo y registra resultados en tiempo real.</p>
            <a href="partidos">Ver Partidos →</a>
        </div>

        <div class="feature-card">
            <div class="feature-icon">📥</div>
            <h3>Importar</h3>
            <p>Carga masiva de datos mediante archivos CSV y JSON.</p>
            <a href="importar">Cargar Datos →</a>
        </div>
    </div>
</div>