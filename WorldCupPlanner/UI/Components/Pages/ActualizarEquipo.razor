@page "/ActualizarEquipo"
@using Servicios.Interfaces
@using Servicios.Modelo
@using Dominio.Enums
@inject NavigationManager Navigation;
@inject IServicioEquipo ServicioEquipo

<div class="wcp-page">
    <div class="wcp-card">
        <h1 class="wcp-title">Actualizar Equipo</h1>
        <p class="wcp-subtitle">Actualizar datos del equipo.</p>
        
        <div class="row g-3">
            <div class="col-md-6">
                <label class="wcp-form-label">Nombre</label>
                <input @bind="equipo.nombre" type="text" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="wcp-form-label">Confederacion</label>
                <select @bind="confederacionSeleccionada" class="form-control">
                    <option value="">Seleccionar confederación</option>
                    <option value="UEFA">UEFA</option>
                    <option value="CONMEBOL">CONMEBOL</option>
                    <option value="CONCACAF">CONCACAF</option>
                    <option value="CAF">CAF</option>
                    <option value="AFC">AFC</option>
                    <option value="OFC">OFC</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="wcp-form-label">Ranking FIFA</label>
                <input @bind="equipo.rankingFifa" type="number" class="form-control" />
            </div>
        </div>

        <div class="wcp-actions mt-3">
            <button @onclick="Guardar" class="wcp-btn-primary">Guardar</button>
            <NavLink href="/equipos" class="wcp-btn-secondary">Cancelar</NavLink>
        </div>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="alert alert-@(esError ? "danger" : "success") mt-3">
                @mensaje
            </div>
        }
    </div>
</div>

@code {
    private EquipoDTO equipo = new EquipoDTO();
    private string confederacionSeleccionada = "";
    private string mensaje = "";
    private bool esError = false;

    protected override void OnInitialized()
    {
        CargarEquipo();
    }

    private void CargarEquipo()
    {
        try
        {
            var queryParams = new Uri(Navigation.Uri).Query;
            var nombreDelEquipo = System.Web.HttpUtility.ParseQueryString(queryParams).Get("nombre");
            
            if (!string.IsNullOrEmpty(nombreDelEquipo))
            {
                equipo = ServicioEquipo.ObtenerEquipo(nombreDelEquipo);
                confederacionSeleccionada = equipo.confederacion.ToString();
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar equipo: {ex.Message}";
            esError = true;
        }
    }

    private void Guardar()
    {
        try
        {
            mensaje = "";
            esError = false;

            if (string.IsNullOrEmpty(confederacionSeleccionada))
            {
                mensaje = "Debe seleccionar una confederación";
                esError = true;
                return;
            }

            // Convertir string a enum
            if (Enum.TryParse<Confederacion>(confederacionSeleccionada, out var confederacion))
            {
                equipo.confederacion = confederacion;
            }
            else
            {
                mensaje = "Confederación inválida";
                esError = true;
                return;
            }

            ServicioEquipo.ActualizarEquipo(equipo);
            mensaje = "Equipo actualizado correctamente";
            esError = false;
            equipo = new EquipoDTO();
            confederacionSeleccionada = "";
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
    }
}