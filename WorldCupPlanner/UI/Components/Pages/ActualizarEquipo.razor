@page "/ActualizarEquipo"
@using Servicios.Interfaces
@using Servicios.Modelo
@using Dominio.Enums
@inject NavigationManager Navigation
@inject IServicioEquipo ServicioEquipo

<div class="wcp-page">
    <div class="wcp-card">
        <h1 class="wcp-title">Actualizar Equipo</h1>
        <p class="wcp-subtitle">Seleccione un equipo registrado y actualice sus datos.</p>

        <EditForm Model="equipo" OnValidSubmit="Guardar" FormName="actualizarEquipoForm">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="wcp-form-label">Equipo a actualizar</label>
                    <select @bind="nombreOriginal" @bind:after="CargarEquipoSeleccionado" class="form-control">
                        <option value="">Seleccionar equipo</option>

                        @foreach (EquipoDTO equipoGuardado in equipos)
                        {
                            <option value="@equipoGuardado.nombre">
                                @equipoGuardado.nombre - @equipoGuardado.confederacion - Ranking @equipoGuardado.rankingFifa
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="wcp-form-label">Nombre</label>
                    <InputText @bind-Value="equipo.nombre" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="wcp-form-label">Confederación</label>
                    <select @bind="confederacionSeleccionada" class="form-control">
                        <option value="">Seleccionar confederación</option>
                        <option value="UEFA">UEFA</option>
                        <option value="CONMEBOL">CONMEBOL</option>
                        <option value="CONCACAF">CONCACAF</option>
                        <option value="CAF">CAF</option>
                        <option value="AFC">AFC</option>
                        <option value="OFC">OFC</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="wcp-form-label">Ranking FIFA</label>
                    <InputNumber @bind-Value="equipo.rankingFifa" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="wcp-form-label">Bandera del país</label>
                    <InputFile OnChange="CargarBandera" accept="image/*" class="form-control" />
                    @if (!string.IsNullOrEmpty(equipo.banderaBase64))
                    {
                        <img src="data:image/*;base64,@equipo.banderaBase64" style="height:40px; margin-top:8px;" />
                    }
                </div>
            </div>

            <div class="wcp-actions mt-3">
                <button type="submit" class="wcp-btn-primary">Guardar</button>
                <NavLink href="/equipos" class="wcp-btn-secondary">Volver</NavLink>
            </div>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-@(esError ? "danger" : "success") mt-3">
                    @mensaje
                </div>
            }
        </EditForm>
    </div>
</div>

@code {
    private List<EquipoDTO> equipos = new List<EquipoDTO>();
    private EquipoDTO equipo = new EquipoDTO();
    private string nombreOriginal = "";
    private string confederacionSeleccionada = "";
    private string mensaje = "";
    private bool esError = false;

    protected override void OnInitialized()
    {
        CargarEquipos();
        CargarNombreDesdeUrl();
    }

    private void CargarEquipos()
    {
        try
        {
            equipos = ServicioEquipo.ObtenerEquipos();
        }
        catch (Exception ex)
        {
            mensaje = "Error al cargar equipos: " + ex.Message;
            esError = true;
        }
    }

    private void CargarNombreDesdeUrl()
    {
        var queryParams = new Uri(Navigation.Uri).Query;
        var nombreDelEquipo = System.Web.HttpUtility.ParseQueryString(queryParams).Get("nombre");

        if (!string.IsNullOrWhiteSpace(nombreDelEquipo))
        {
            nombreOriginal = nombreDelEquipo;
            CargarEquipoSeleccionado();
        }
    }

    private void CargarEquipoSeleccionado()
    {
        try
        {
            mensaje = "";
            esError = false;

            if (string.IsNullOrWhiteSpace(nombreOriginal))
            {
                equipo = new EquipoDTO();
                confederacionSeleccionada = "";
                return;
            }

            equipo = ServicioEquipo.ObtenerEquipo(nombreOriginal);
            confederacionSeleccionada = equipo.confederacion.ToString();
        }
        catch (Exception ex)
        {
            mensaje = "Error al cargar equipo: " + ex.Message;
            esError = true;
        }
    }

    private void Guardar()
    {
        try
        {
            mensaje = "";
            esError = false;

            if (string.IsNullOrWhiteSpace(nombreOriginal))
            {
                mensaje = "Debe seleccionar un equipo.";
                esError = true;
                return;
            }

            if (string.IsNullOrWhiteSpace(confederacionSeleccionada))
            {
                mensaje = "Debe seleccionar una confederación.";
                esError = true;
                return;
            }

            if (Enum.TryParse<Confederacion>(confederacionSeleccionada, out var confederacion))
            {
                equipo.confederacion = confederacion;
            }
            else
            {
                mensaje = "Confederación inválida";
                esError = true;
                return;
            }

            ServicioEquipo.ActualizarEquipo(nombreOriginal, equipo);

            mensaje = "Equipo actualizado correctamente";
            esError = false;
            nombreOriginal = equipo.nombre;
            CargarEquipos();
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
    }
    private async Task CargarBandera(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        using var stream = archivo.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
        var buffer = new byte[archivo.Size];
        await stream.ReadAsync(buffer);
        equipo.banderaBase64 = Convert.ToBase64String(buffer);
    }

}