@page "/estadios"
@using Dominio.Enums
@using Servicios.Interfaces
@using UI.Estado
@using Servicios.Modelo
@inject IServicioEstadio ServicioEstadio
@inject UsuarioSesion Sesion

<div class="wcp-page">
    <div class="wcp-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                @if (!Sesion.UsuarioActual.Roles.Contains(Rol.Administrador))
                {
                    <div class="alert alert-danger wcp-alert">Solo un administrador puede gestionar estadios.</div>
                }
                <h1 class="wcp-title">Estadios</h1>
                <p class="wcp-subtitle">Listado de estadios registrados en el sistema.</p>
            </div>
            @if (Sesion.UsuarioActual.Roles.Contains(Rol.Administrador))
            {
                <NavLink href="/AgregarEstadio" class="wcp-btn-primary">Agregar Estadio</NavLink>
            }
        </div>
    </div>

    @if (estadios != null && estadios.Count > 0)
    {
        <div class="wcp-card mt-4">
            <table class="wcp-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Ciudad</th>
                        <th>Descripción</th>
                        <th>Capacidad</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var estadio in estadios)
                    {
                        <tr>
                            <td>@estadio.Nombre</td>
                            <td>@estadio.Ciudad</td>
                            <td>@estadio.Descripcion</td>
                            <td>@estadio.CapacidadLocativa?.ToString("N0")</td>
                            <td>
                                @if (Sesion.UsuarioActual.Roles.Contains(Rol.Administrador))
                                {
                                    <NavLink href="@($"/ActualizarEstadio?nombre={Uri.EscapeDataString(estadio.Nombre)}")" class="wcp-action-link wcp-action-edit">Editar</NavLink>
                                    <NavLink href="@($"/EliminarEstadio?nombre={Uri.EscapeDataString(estadio.Nombre)}")" class="wcp-action-link wcp-action-delete">Eliminar</NavLink>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="wcp-card mt-4">
            <p class="text-center text-muted">No hay estadios registrados</p>
        </div>
    }
</div>

@code {
    private List<EstadioDTO> estadios = new List<EstadioDTO>();

    protected override void OnInitialized()
    {
        CargarEstadios(); 
        estadios = ServicioEstadio.ObtenerEstadios();
        
    }

    private void CargarEstadios()
    {
        estadios = ServicioEstadio.ObtenerEstadios();
    }
}