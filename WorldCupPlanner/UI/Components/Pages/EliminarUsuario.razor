@page "/EliminarUsuario"
@using Servicios.Interfaces
@using Servicios.Modelo
@using UI.Estado
@inject IServicioUsuario ServicioUsuario
@inject UsuarioSesion UsuarioActivo
@inject NavigationManager Navigation

<div class="wcp-page">
    <div class="wcp-card">
        <h1 class="wcp-title">Eliminar Usuario</h1>
        <p class="wcp-subtitle">Seleccione un usuario y confirme su email para eliminarlo.</p>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="wcp-form-label">Usuario</label>
                <select @bind="emailSeleccionado" class="form-control">
                    <option value="">Seleccionar usuario</option>

                    @foreach (UsuarioDTO usuario in usuariosEliminables)
                    {
                        <option value="@usuario.Email">
                            @usuario.Nombre @usuario.Apellido - @usuario.Email
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="wcp-form-label">Confirmar email</label>
                <input @bind="emailConfirmado" class="form-control" />
            </div>
        </div>

        <div class="wcp-actions mt-3">
            <button @onclick="Eliminar" class="wcp-btn-danger">Eliminar</button>
            <NavLink href="/usuarios" class="wcp-btn-secondary">Volver</NavLink>
        </div>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="alert alert-@(esError ? "danger" : "success") mt-3">
                @mensaje
            </div>
        }
    </div>
</div>

@code {
    private List<UsuarioDTO> usuariosEliminables = new List<UsuarioDTO>();
    private string emailSeleccionado = "";
    private string emailConfirmado = "";
    private string mensaje = "";
    private bool esError = false;

    protected override void OnInitialized()
    {
        CargarUsuarios();
        CargarEmailDesdeUrl();
    }

    private void CargarUsuarios()
    {
        usuariosEliminables = ServicioUsuario.ObtenerUsuariosEliminables(UsuarioActivo.UsuarioActual.Email);
    }

    private void CargarEmailDesdeUrl()
    {
        string query = new Uri(Navigation.Uri).Query;
        string? email = System.Web.HttpUtility.ParseQueryString(query).Get("email");

        if (!string.IsNullOrWhiteSpace(email))
        {
            emailSeleccionado = email;
        }
    }

    private void Eliminar()
    {
        try
        {
            ServicioUsuario.EliminarUsuario(
                emailSeleccionado,
                emailConfirmado,
                UsuarioActivo.UsuarioActual.Email
            );

            mensaje = "Usuario eliminado correctamente";
            esError = false;
            emailSeleccionado = "";
            emailConfirmado = "";

            CargarUsuarios();
        }
        catch (ArgumentException ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
        catch (Exception)
        {
            mensaje = "Ocurrió un error inesperado. Intente nuevamente.";
            esError = true;
        }
    }
}