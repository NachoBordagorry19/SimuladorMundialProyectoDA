@page "/"
@page "/home"

<div class="home-wrapper">
    <div class="hero-section">
        <div class="hero-header">
            <div class="hero-line"></div>
            <h1>WorldCupPlanner</h1>
            <div class="hero-line"></div>
        </div>
        <div class="hero-accent"></div>
        <p>La plataforma definitiva para la gestión y simulación de torneos internacionales.</p>
        
        <div class="hero-btns">
            <a href="usuarios" class="btn-main">Gestionar Usuarios</a>
            <a href="equipos" class="btn-main">Ver Equipos</a>
        </div>
    </div>

    <div class="features-grid">
        <a href="fixture" class="feature-card">
            <div class="feature-icon">📅</div>
            <h3>Fixture</h3>
            <p>Organiza los grupos y las fases eliminatorias del mundial.</p>
            <span class="feature-link">Explorar →</span>
        </a>

        <a href="partidos" class="feature-card">
            <div class="feature-icon">⚽</div>
            <h3>Partidos</h3>
            <p>Consulta el calendario completo y registra resultados en tiempo real.</p>
            <span class="feature-link">Ver Partidos →</span>
        </a>

        <a href="importar" class="feature-card">
            <div class="feature-icon">📥</div>
            <h3>Importar</h3>
            <p>Carga masiva de datos mediante archivos CSV y JSON.</p>
            <span class="feature-link">Cargar Datos →</span>
        </a>
    </div>
</div>