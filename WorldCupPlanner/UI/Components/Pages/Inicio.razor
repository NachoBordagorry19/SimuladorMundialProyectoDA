@page "/home"
@page "/"

<div class="inicio-container">
    <header class="inicio-hero">
        <div class="hero-content">
            <h1 class="hero-title">WorldCupPlanner</h1>
            <div class="hero-line"></div>
            <p class="hero-sub">La plataforma definitiva para la gestión y simulación de torneos internacionales.</p>
            <div class="hero-actions">
                <NavLink class="btn-principal" href="/usuarios">Gestionar Usuarios</NavLink>
                <NavLink class="btn-secundario" href="/equipos">Ver Equipos</NavLink>
            </div>
        </div>
    </header>

    <section class="inicio-grid" aria-label="Secciones de acceso rápido">
        <div class="card-interactiva">
            <div class="card-icon">📅</div>
            <h3>Fixture</h3>
            <p>Organiza los grupos y las fases eliminatorias del mundial.</p>
            <NavLink href="/fixture" class="card-link">Explorar →</NavLink>
        </div>

        <div class="card-interactiva">
            <div class="card-icon">⚽</div>
            <h3>Partidos</h3>
            <p>Consulta el calendario completo y registra los resultados en tiempo real.</p>
            <NavLink href="/partidos" class="card-link">Explorar →</NavLink>
        </div>

        <div class="card-interactiva">
            <div class="card-icon">📥</div>
            <h3>Importar</h3>
            <p>Carga masiva de datos mediante archivos CSV y JSON.</p>
            <NavLink href="/importar" class="card-link">Explorar →</NavLink>
        </div>
    </section>
</div>