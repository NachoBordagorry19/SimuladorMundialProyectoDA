@page "/home"
@page "/"

<div class="inicio-container">
    <section class="inicio-hero">
        <h1 class="hero-title">WorldCupPlanner</h1>
        <div class="hero-line"></div>
        <p class="hero-sub">La plataforma definitiva para la gestión y simulación de torneos internacionales.</p>
        
        <div class="hero-actions">
            <a href="usuarios" class="btn-principal">Gestionar Usuarios</a>
            <a href="equipos" class="btn-secundario">Ver Equipos</a>
        </div>
    </section>

    <div class="inicio-grid">
        <div class="card-interactiva">
            <div class="card-icon">📅</div>
            <h3>Fixture</h3>
            <p>Organiza los grupos y las fases eliminatorias del mundial.</p>
            <a href="fixture" class="card-link">Explorar →</a>
        </div>

        <div class="card-interactiva">
            <div class="card-icon">⚽</div>
            <h3>Partidos</h3>
            <p>Consulta el calendario completo y registra los resultados en tiempo real.</p>
            <a href="partidos" class="card-link">Ver Partidos →</a>
        </div>

        <div class="card-interactiva">
            <div class="card-icon">📥</div>
            <h3>Importar</h3>
            <p>Carga masiva de datos mediante archivos CSV y JSON de forma rápida.</p>
            <a href="importar" class="card-link">Cargar Datos →</a>
        </div>
    </div>
</div>