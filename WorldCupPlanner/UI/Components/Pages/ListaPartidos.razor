@page "/partidos"
@rendermode InteractiveServer
@using Dominio.Enums
@using Servicios.Interfaces
@using UI.Estado
@using Servicios.Modelo
@inject IServicioPartido ServicioPartido
@inject IServicioCrucesSegundaFase ServicioCruces
@inject UsuarioSesion Sesion

<div class="wcp-page">
    <div class="wcp-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="wcp-title">Partidos</h1>
                <p class="wcp-subtitle">Listado de partidos programados en el sistema.</p>
            </div>

            @if (!Sesion.UsuarioActual.Roles.Contains(Rol.Editor))
            {
                <div class="alert alert-danger wcp-alert">Solo un editor puede gestionar partidos.</div>
            }
            @if (Sesion.UsuarioActual.Roles.Contains(Rol.Editor))
            {
                <NavLink href="/fixture" class="wcp-btn-primary">Ver Fixture</NavLink>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="alert alert-danger wcp-alert mt-3">@mensajeError</div>
        }

        @if (!string.IsNullOrWhiteSpace(mensajeExito))
        {
            <div class="alert alert-success wcp-alert mt-3">@mensajeExito</div>
        }

        <div class="row g-3 mt-3">
            <div class="col-md-3">
                <label class="wcp-form-label">Fecha</label>
                <InputDate @bind-Value="fechaFiltro" class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="wcp-form-label">Estadio</label>
                <select class="form-control" @bind="estadioFiltro">
                    <option value="">Todos</option>
                    @foreach (var estadio in estadios)
                    {
                        <option value="@estadio">@estadio</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="wcp-form-label">Grupo</label>
                <select class="form-control" @bind="grupoFiltro">
                    <option value="">Todos</option>
                    @foreach (var grupo in grupos)
                    {
                        <option value="@grupo">@grupo</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="wcp-form-label">Fase</label>
                <select class="form-control" @bind="faseFiltro">
                    <option value="">Todas</option>
                    @foreach (var fase in fases)
                    {
                        <option value="@fase">@fase</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="wcp-form-label">Semilla Simulación</label>
                <InputNumber @bind-Value="semillaSimulacion" class="form-control" />
            </div>
        </div>

        <div class="wcp-actions">
            <button class="wcp-btn-secondary" @onclick="AplicarFiltros">
                Aplicar filtros
            </button>

            <button class="wcp-btn-secondary" @onclick="LimpiarFiltros">
                Limpiar filtros
            </button>

            <button class="wcp-btn-primary" @onclick="SimularTodosLosPartidos">
                Simular partidos pendientes
            </button>
        </div>
    </div>

    @if (partidos.Count > 0)
    {
        <div class="wcp-card mt-4">
            <table class="wcp-table">
                <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Grupo</th>
                    <th>Fase</th>
                    <th>Local</th>
                    <th>Visitante</th>
                    <th>Estadio</th>
                    <th>Estado</th>
                    <th>Resultado</th>
                    <th>Acciones</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var partido in partidos)
                {
                    <tr>
                        <td>@partido.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@partido.Grupo</td>
                        <td>@partido.fase</td>
                        <td>@partido.equipoLocal.nombre</td>
                        <td>@partido.equipoVisitante.nombre</td>
                        <td>@partido.Estadio.Nombre</td>
                        <td>@partido.estadoPartido</td>
                        <td>@partido.golesLocal - @partido.golesVisitante</td>
                        <td>
                            @if (Sesion.UsuarioActual.Roles.Contains(Rol.Editor))
                            {
                                <NavLink href="@($"/EditarPartido/{partido.idPartido}")" class="wcp-action-link wcp-action-edit">
                                    Editar
                                </NavLink>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="wcp-card mt-4">
            <p class="text-center text-muted mb-0">No hay partidos para mostrar.</p>
        </div>
    }
</div>

@code {
    private List<PartidoDTO> partidos = new List<PartidoDTO>();
    private List<string> estadios = new List<string>();
    private List<string> grupos = new List<string>();
    private List<string> fases = new List<string>();

    private DateTime? fechaFiltro;
    private string estadioFiltro = "";
    private string grupoFiltro = "";
    private string faseFiltro = "";

    private int semillaSimulacion = 123;

    private string mensajeError = "";
    private string mensajeExito = "";

    protected override void OnInitialized()
    {
        CargarDatos();
    }

    private void CargarDatos()
    {
        try
        {
            mensajeError = "";
            mensajeExito = "";

            estadios = ServicioPartido.ObtenerEstadiosDePartidos();
            grupos = ServicioPartido.ObtenerGruposDePartidos();
            fases = ServicioPartido.ObtenerFasesDePartidos();

            CargarPartidos();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
            mensajeExito = "";
        }
    }

    private void CargarPartidos()
    {
        partidos = ServicioPartido.ObtenerPartidosFiltrados(
            fechaFiltro,
            estadioFiltro,
            grupoFiltro,
            faseFiltro);
    }

    private void AplicarFiltros()
    {
        try
        {
            mensajeError = "";
            mensajeExito = "";

            CargarPartidos();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
            mensajeExito = "";
        }
    }

    private void LimpiarFiltros()
    {
        try
        {
            mensajeError = "";
            mensajeExito = "";

            fechaFiltro = null;
            estadioFiltro = "";
            grupoFiltro = "";
            faseFiltro = "";

            CargarPartidos();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
            mensajeExito = "";
        }
    }

    private void SimularTodosLosPartidos()
    {
        try
        {
            mensajeError = "";
            mensajeExito = "";

            ServicioPartido.SimularTodosLosPartidos(semillaSimulacion);

            ServicioCruces.ProcesarAvanceDelTorneo();

            CargarDatos();

            mensajeExito = "Partidos pendientes simulados correctamente.";
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
            mensajeExito = "";
        }
    }
}