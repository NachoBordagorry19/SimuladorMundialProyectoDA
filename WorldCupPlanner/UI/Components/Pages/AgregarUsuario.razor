@page "/AgregarUsuario"
@using Dominio.Enums
@using Servicios.Interfaces
@using Servicios.Modelo
@using UI.Estado
@inject IServicioUsuario ServicioUsuario
@inject UsuarioSesion Sesion
@inject NavigationManager Navigation

<div class="wcp-page">
    <div class="wcp-card">
        <h1 class="wcp-title">Agregar Usuario</h1>
        <p class="wcp-subtitle">Crear un nuevo usuario del sistema.</p>

        @if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="alert alert-danger wcp-alert">@mensajeError</div>
        }

        <EditForm Model="usuario" OnValidSubmit="OnSave" FormName="agregarUsuarioForm">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="wcp-form-label">Nombre</label>
                    <InputText @bind-Value="usuario.Nombre" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="wcp-form-label">Apellido</label>
                    <InputText @bind-Value="usuario.Apellido" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="wcp-form-label">Email</label>
                    <InputText @bind-Value="usuario.Email" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="wcp-form-label">Fecha de nacimiento</label>
                    <InputDate @bind-Value="usuario.FechaNacimiento" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="wcp-form-label">Contraseña</label>
                    <InputText @bind-Value="usuario.Contraseña" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="wcp-form-label">Roles</label>

                    <div class="form-check">
                        <InputCheckbox @bind-Value="esAdministrador" class="form-check-input" />
                        <label class="form-check-label">Administrador</label>
                    </div>

                    <div class="form-check">
                        <InputCheckbox @bind-Value="esEditor" class="form-check-input" />
                        <label class="form-check-label">Editor</label>
                    </div>
                </div>
            </div>

            <div class="wcp-actions">
                <button type="submit" class="wcp-btn-primary">Guardar</button>
                <NavLink href="/usuarios" class="wcp-btn-secondary">Cancelar</NavLink>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private UsuarioDTO usuario = new UsuarioDTO()
    {
        Nombre = "",
        Apellido = "",
        Email = "",
        FechaNacimiento = DateTime.Today.AddYears(-18),
        Contraseña = "",
        Roles = new List<Rol>()
    };

    private bool esAdministrador;
    private bool esEditor = true;
    private string? mensajeError;

    protected override void OnInitialized()
    {
        if (Sesion.UsuarioActual == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!Sesion.UsuarioActual.Roles.Contains(Rol.Administrador))
        {
            Navigation.NavigateTo("/home");
        }
    }

    private void OnSave()
    {
        try
        {
            usuario.Roles = new List<Rol>();

            if (esAdministrador)
            {
                usuario.Roles.Add(Rol.Administrador);
            }

            if (esEditor)
            {
                usuario.Roles.Add(Rol.Editor);
            }

            ServicioUsuario.AgregarUsuario(usuario);

            Navigation.NavigateTo("/usuarios");
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }
}