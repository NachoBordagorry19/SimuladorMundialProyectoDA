@page "/"
@page "/AgregarUsuario"

@using Dominio.Clases

<h3>Agregar Usuario</h3>

<EditForm Model="usuario" OnSubmit="OnSave">
    <input type="text" @bind-value="usuario.Nombre" id="nombre" placeholder="Nombre">
</EditForm>

@code {
    public Usuario usuario { get; set; }
    
    public void OnSave()
    {
        Console.WriteLine("Usuario guardado");
    }
}