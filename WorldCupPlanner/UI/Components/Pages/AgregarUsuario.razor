@page "/AgregarUsuario"
@using Dominio.Clases
@using Dominio.Enums

<div class="home-container">
    <h3>Crear Nuevo Usuario</h3>

    <EditForm Model="usuario" OnValidSubmit="OnSave">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Nombre:</label>
            <InputText @bind-Value="usuario.Nombre" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Email:</label>
            <InputText @bind-Value="usuario.Email" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Rol:</label>
            <InputSelect @bind-Value="rolSeleccionado" class="form-select">
                @foreach (var r in Enum.GetValues<Rol>()) {
                    <option value="@r">@r</option>
                }
            </InputSelect>
        </div>
        
        <button type="submit" class="btn">Guardar Usuario</button>
    </EditForm>
</div>

@code {
    public Usuario usuario = new Usuario("", "", "", DateTime.Today.AddYears(-18), "Pass123!", Rol.Editor);
    private Rol rolSeleccionado = Rol.Editor;
    
    public void OnSave() {
        Console.WriteLine($"Usuario {usuario.Nombre} registrado con rol {rolSeleccionado}");
    }
}